# Loaded by docker-compose into containers as process env vars.
# Containers do NOT mount this file; pydantic-settings reads from os.environ.
# Copy to .env and replace JWT_SECRET with output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Postgres
POSTGRES_USER=ibkr
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ibkr_control
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://ibkr:changeme@postgres:5432/ibkr_control
JWT_SECRET=changeme-min-32-chars-please-rotate
JWT_LIFETIME_SECONDS=3600
BACKEND_CORS_ORIGINS=http://localhost:3000

# AES-GCM key for Flex token encryption (32 bytes base64).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=REPLACE_ME_WITH_OPENSSL_OUTPUT
